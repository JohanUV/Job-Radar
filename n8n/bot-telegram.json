      "parameters": {
        "jsCode": "const r = $json;\nconst texto = r?.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || '';\nconst prep = $('Preparar Prompt').first().json;\n\nif (!texto) {\n  throw new Error('Gemini no devolvió texto: ' + JSON.stringify(r).slice(0, 300));\n}\n\nreturn [{ json: {\n  vacante: prep.vacante_id,\n  perfil: prep.perfil_id,\n  texto,\n  modelo: 'gemini-3.5-flash-lite'\n}}];"
      },
