    {
      "parameters": {
        "jsCode": "const r = $('Router').first().json;\nconst datos = $input.first().json;\nconst lista = datos.resultados || [];\n\nconst esc = (s = '') => String(s)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nif (!lista.length) {\n  return [{ json: {\n    chat_id: r.chat_id,\n    texto: 'Todavía no tengo vacantes evaluadas para ti.\\n\\nSi ya mandaste tu CV, espera a la próxima corrida del evaluador (cada 6 horas). Si no, mándamelo en PDF.'\n  }}];\n}\n\nconst bloques = lista.slice(0, 5).map((ev, i) => {\n  const razones = Array.isArray(ev.razones) ? ev.razones.slice(0, 2) : [];\n  return [\n    `<b>${i + 1}. ${esc(ev.titulo)}</b> — ${ev.puntuacion}/100`,\n    `${esc(ev.empresa || 'Empresa no indicada')}${ev.ubicacion ? ' · ' + esc(ev.ubicacion) : ''}`,\n    razones.length ? `<i>${esc(razones.join(' · '))}</i>` : null,\n    `<a href=\"${esc(ev.url)}\">Ver vacante</a> · via ${esc(ev.fuente)}`\n  ].filter(Boolean).join('\\n');\n});\n\nlet texto = `🎯 <b>Tus mejores coincidencias</b> (${datos.total} en total)\\n\\n` + bloques.join('\\n\\n');\nif (texto.length > 4000) texto = texto.slice(0, 3950) + '\\n\\n…recortado.';\n\nreturn [{ json: { chat_id: r.chat_id, texto } }];"
      },
