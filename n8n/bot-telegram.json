    {
      "parameters": {
        "jsCode": "const r = $('Router').first().json;\nconst datos = $input.first().json;\nconst lista = datos.resultados || [];\n\nconst esc = (s = '') => String(s)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nif (!lista.length) {\n  return [{ json: {\n    chat_id: r.chat_id,\n    texto: `No encontré nada para <b>${esc(r.arg)}</b>.\\n\\nPrueba con un término más corto o en inglés — la mayoría de las ofertas están en ese idioma.`\n  }}];\n}\n\nconst bloques = lista.slice(0, 5).map((v, i) => [\n  `<b>${i + 1}. ${esc(v.titulo)}</b>`,\n  `${esc(v.empresa || 'Empresa no indicada')}${v.ubicacion ? ' · ' + esc(v.ubicacion) : ''}`,\n  `<a href=\"${esc(v.url)}\">Ver vacante</a> · via ${esc(v.fuente)}`\n].join('\\n'));\n\nconst extra = datos.total > 5 ? `\\n\\nMostrando 5 de ${datos.total}. Afina la búsqueda para ver otras.` : '';\nlet texto = `🔎 <b>Resultados para \"${esc(r.arg)}\"</b>\\n\\n` + bloques.join('\\n\\n') + extra;\nif (texto.length > 4000) texto = texto.slice(0, 3950) + '\\n\\n…recortado.';\n\nreturn [{ json: { chat_id: r.chat_id, texto } }];"
      },
