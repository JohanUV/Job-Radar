        "jsCode": "const prep = $('Preparar Prompt').first().json;\nconst bruto = $('Parsear Carta').first().json.texto;\n\nconst limpio = bruto.replace(/\\*+/g, '');\n\nconst esc = limpio\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst texto = `📄 <b>Borrador de carta — vacante ${prep.vacante_id}</b>\\n\\n${esc.slice(0, 3800)}`;\n\nreturn [{ json: { texto } }];"
