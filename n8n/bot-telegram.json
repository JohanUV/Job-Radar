    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst u = item.json;\nconst msg = u.message || u.edited_message || {};\nconst chatId = msg.chat?.id;\nconst texto = (msg.text || msg.caption || '').trim();\nconst doc = msg.document || null;\n\nconst permitidos = [1792767565];\n\nlet intent = 'desconocido';\nlet arg = '';\n\nif (!permitidos.includes(chatId)) {\n  intent = 'no_autorizado';\n} else if (doc) {\n  intent = doc.mime_type === 'application/pdf' ? 'cv' : 'mime_malo';\n} else if (texto.startsWith('/')) {\n  const partes = texto.split(' ');\n  const cmd = partes[0].split('@')[0].toLowerCase();\n  arg = partes.slice(1).join(' ').trim();\n  if (['/start', '/ayuda', '/help'].includes(cmd)) intent = 'ayuda';\n  else if (cmd === '/mejores') intent = 'mejores';\n  else if (cmd === '/buscar') intent = arg ? 'buscar' : 'ayuda';\n  else if (cmd === '/carta') {\n    const n = parseInt(arg, 10);\n    if (Number.isInteger(n) && n > 0) { intent = 'carta'; arg = String(n); }\n    else intent = 'desconocido';\n  }\n  else intent = 'desconocido';\n} else if (texto) {\n  intent = 'buscar';\n  arg = texto;\n}\n\nreturn [{\n  json: { intent, arg, chat_id: chatId, nombre: msg.from?.first_name || '', archivo: doc?.file_name || '' },\n  binary: item.binary\n}];"
      },
