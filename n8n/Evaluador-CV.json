      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst cv = d.texto_cv;\n\nreturn (d.pendientes || []).map(v => ({\n  json: {\n    perfil: d.perfil_id,\n    vacante: v.id,\n    titulo: v.titulo,\n    prompt: `Eres un asistente de busqueda de empleo. Compara este CV con esta vacante.\n\nCV:\n${cv}\n\nVACANTE:\nTitulo: ${v.titulo}\nEmpresa: ${v.empresa}\nDescripcion: ${(v.descripcion || '').slice(0, 3000)}\n\nResponde UNICAMENTE con un objeto JSON valido, sin markdown, sin backticks, con esta forma exacta:\n{\"puntuacion\": <numero entero de 0 a 100>, \"razones\": [\"razon 1\", \"razon 2\", \"razon 3\"]}\n\nLa puntuacion mide que tanto encaja el perfil con la vacante. Las razones deben ser cortas y en espanol.`\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "192315d3-cd42-4ef0-86ff-e618637b4d28",
      "name": "Preparar Prompts"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "id": "b20e30c0-e0fa-4fe5-b7a3-ec4c56524bd8",
      "name": "Gemini",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Txaz6WVBxdWG89NW",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Preparar Prompts').all().map(i => i.json);\nconst evaluaciones = [];\n\n$input.all().forEach((item, idx) => {\n  const texto = item.json?.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  const limpio = texto.replace(/```json/g, '').replace(/```/g, '').trim();\n  try {\n    const r = JSON.parse(limpio);\n    evaluaciones.push({\n      perfil: prep[idx].perfil,\n      vacante: prep[idx].vacante,\n      puntuacion: r.puntuacion,\n      razones: r.razones || [],\n      modelo: 'gemini-2.5-flash',\n    });\n  } catch (e) {\n    // respuesta no parseable: se omite en vez de romper el flujo\n  }\n});\n\nreturn [{ json: { evaluaciones, total: evaluaciones.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
