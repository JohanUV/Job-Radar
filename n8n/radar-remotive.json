      "id": "499edcf2-8850-4141-862e-a00c50a3c049",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total = items.length;\nconst top = items.slice(0, 5);\n\nlet texto = `Radar de empleos — ${total} vacantes encontradas\\n\\n`;\n\nfor (const it of top) {\n  const j = it.json;\n  texto += `${j.titulo}\\n${j.empresa} — ${j.ubicacion}\\n${j.url}\\n\\n`;\n}\n\nif (total > top.length) {\n  texto += `y ${total - top.length} más en el listado.`;\n}\n\nreturn [{ json: { mensaje: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ],
      "id": "08abb1fd-888f-43e4-8866-82af1be6b5f8",
      "name": "Armar Mensaje"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.first().json.jobs || [];\n\nreturn jobs.map(j => ({\n  json: {\n    titulo: j.title,\n    empresa: j.company_name,\n    descripcion: (j.description || '').replace(/<[^>]*>/g, '').trim(),\n    ubicacion: j.candidate_required_location || 'No especificada',\n    tipo: j.job_type || null,\n    categoria: j.category || null,\n    url: j.url,\n    fuente: 'remotive',\n    fecha_publicacion: j.publication_date,\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
