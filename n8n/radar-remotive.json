    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.first().json.data || [];\n\nconst filtrados = jobs.filter(j =>\n  j.remote === true &&\n  /developer|engineer|software|data|security|devops|analyst|IT|cyber/i.test(\n    (j.title || '') + ' ' + (j.tags || []).join(' ')\n  )\n);\n\nreturn filtrados.slice(0, 20).map(j => ({\n  json: {\n    titulo: j.title,\n    empresa: j.company_name,\n    descripcion: (j.description || '').replace(/<[^>]*>/g, '').trim().slice(0, 5000),\n    ubicacion: j.location || 'No especificada',\n    tipo: j.job_types?.[0] || null,\n    categoria: j.tags?.[0] || null,\n    url: j.url,\n    fuente: 'arbeitnow',\n    fecha_publicacion: j.created_at ? new Date(j.created_at * 1000).toISOString() : null,\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
