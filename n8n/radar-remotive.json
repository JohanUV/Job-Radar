    },
    {
      "parameters": {
        "jsCode": "let items = $input.all().map(i => i.json);\n\nif (items.length === 1 && Array.isArray(items[0].data)) {\n  items = items[0].data;\n}\n\nconst jobs = items.filter(j => j && j.id && j.position);\n\nreturn jobs.slice(0, 20).map(j => ({\n  json: {\n    titulo: j.position,\n    empresa: j.company,\n    descripcion: (j.description || '').replace(/<[^>]*>/g, '').trim().slice(0, 5000),\n    ubicacion: j.location || 'Remoto',\n    tipo: 'remoto',\n    categoria: j.tags?.[0] || null,\n    url: j.url,\n    fuente: 'remoteok',\n    fecha_publicacion: j.date || null,\n  }\n}));"
      },
