      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const resumen = $input.first().json;\nconst vacantes = $('Normalizar Vacantes').all().map(i => i.json);\n\nif (!resumen.creadas) {\n  return [{ json: { mensaje: `Radar: sin vacantes nuevas (${resumen.duplicadas} ya registradas).` } }];\n}\n\nconst nuevas = vacantes.slice(0, resumen.creadas);\nlet texto = `Radar de empleos — ${resumen.creadas} vacantes nuevas\\n\\n`;\n\nfor (const v of nuevas.slice(0, 5)) {\n  texto += `${v.titulo}\\n${v.empresa} — ${v.ubicacion}\\n${v.url}\\n\\n`;\n}\n\nif (resumen.creadas > 5) {\n  texto += `y ${resumen.creadas - 5} más en el sistema.`;\n}\n\nreturn [{ json: { mensaje: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        0
      ],
      "id": "08abb1fd-888f-43e4-8866-82af1be6b5f8",
      "name": "Armar Mensaje"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.first().json.jobs || [];\n\nreturn jobs.map(j => ({\n  json: {\n    titulo: j.title,\n    empresa: j.company_name,\n    descripcion: (j.description || '').replace(/<[^>]*>/g, '').trim(),\n    ubicacion: j.candidate_required_location || 'No especificada',\n    tipo: j.job_type || null,\n    categoria: j.category || null,\n    url: j.url,\n    fuente: 'remotive',\n    fecha_publicacion: j.publication_date,\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ],
      "id": "50ff9708-acdb-40fe-b2ca-3291070482c7",
